# ============================================================
#  ERP Genia Creativa (Laravel) - configuración de PRODUCCIÓN
#  1) Completa los valores que dicen CAMBIAR (justo después del =, sin espacios ni comentarios)
#  2) Sube este archivo a la carpeta del ERP y RENÓMBRALO a  .env
#  Nunca compartas este archivo: contiene claves.
# ============================================================
APP_NAME="ERP Genia Creativa"
APP_ENV=production
APP_KEY=CAMBIAR
APP_DEBUG=false
APP_URL=https://erp.gcreativa.com
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=single
LOG_LEVEL=error

# Base de datos creada en cPanel > Bases de datos MySQL
# (en cPanel el nombre y el usuario llevan el prefijo de tu cuenta, ej. gcreativa_erp)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

# MISMO valor que JWT_SECRET del archivo backend/.env del ERP Node.
# Así las contraseñas y sesiones siguen funcionando igual.
JWT_SECRET=CAMBIAR

# Consulta DNI/RUC (opcional, mismo valor que tenías en Node)
CONSULTA_DOC_TOKEN=

# Publicar catálogo en gcreativa.com
# Ruta ABSOLUTA del catalogo.json de la web y carpeta para sus fotos (cPanel > Administrador de archivos muestra /home/CUENTA/...)
CATALOGO_WEB_PATH=/home/CUENTA/public_html/data/catalogo.json
CATALOGO_WEB_IMAGENES=/home/CUENTA/public_html/img/catalogo
CATALOGO_WEB_URL_IMAGENES=/img/catalogo

# Solo para la PRIMERA instalación: escribe una clave, abre https://erp.gcreativa.com/instalar?token=ESA_CLAVE
# y luego BORRA esta línea.
SETUP_TOKEN=
# Si la base es nueva, usuario administrador que se creará:
ADMIN_EMAIL=admin@gcreativa.com
ADMIN_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
