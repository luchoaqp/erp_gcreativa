---
import { sitio } from '../data/sitio.js';

const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor">
    <div class="pie__grid">
      <div>
        <a class="marca" href="/">
          <img class="marca__logo" src={sitio.logo} alt={sitio.nombre} width="300" height="116" />
        </a>
        <p data-t="pie_frase">Armamos cada regalo a mano y lo entregamos con tu dedicatoria.</p>
      </div>
      <div>
        <h2>Catálogos</h2>
        <ul id="pie-catalogos">
          <li><a href="/catalogo/">Ver todos</a></li>
        </ul>
      </div>
      <div>
        <h2>La tienda</h2>
        <ul>
          <li><a href="/nosotros/">Quiénes somos</a></li>
          <li><a href="/catalogo/">Catálogo</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h2>Escríbenos</h2>
        <ul>
          <li><a data-contacto="whatsapp" data-prefijo="WhatsApp " href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener">WhatsApp {sitio.telefonoVisible}</a></li>
          <li><a data-contacto="email" href={`mailto:${sitio.email}`}>{sitio.email}</a></li>
          <li><a data-contacto="instagram" href={sitio.redes.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a data-contacto="facebook" href={sitio.redes.facebook} target="_blank" rel="noopener">Facebook</a></li>
          <li><a data-contacto="tiktok" href={sitio.redes.tiktok} target="_blank" rel="noopener">TikTok</a></li>
        </ul>
      </div>
    </div>
    <div class="pie__legal">
      <span>© {anio} {sitio.nombre}. Todos los derechos reservados.</span>
      <span data-contacto="direccion">{sitio.direccion}</span>
    </div>
  </div>
</footer>

<script>
  // Lista de catálogos del pie, según lo publicado desde el ERP
  import { cargarCatalogo } from '../lib/catalogo.js';
  const ul = document.getElementById('pie-catalogos');
  cargarCatalogo()
    .then((d) => {
      const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
      const items = d.catalogos.slice(0, 8).map((c) => `<li><a href="/catalogo/?catalogo=${encodeURIComponent(c.slug)}">${esc(c.nombre)}</a></li>`);
      if (items.length) ul.innerHTML = items.join('') + '<li><a href="/catalogo/">Ver todos</a></li>';
    })
    .catch(() => {});
</script>
