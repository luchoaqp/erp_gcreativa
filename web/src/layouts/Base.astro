---
// Plantilla base: <head>, cabecera, pie y botón de WhatsApp. Todas las páginas la usan.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { sitio } from '../data/sitio.js';
import { enlaceWhatsApp } from '../lib/render.js';
import { iconoWhatsApp } from '../components/Iconos.js';

const { titulo, descripcion = 'Regalos y detalles personalizados para cumpleaños, aniversarios, fechas especiales y empresas.' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${sitio.nombre}` : `${sitio.nombre} — ${sitio.lema}`;
const canonica = new URL(Astro.url.pathname, sitio.url).href;
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#DE569A" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_PE" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <a class="wa-flotante" href={enlaceWhatsApp('Hola Genia Creativa, quiero hacer un pedido.')} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
      <Fragment set:html={iconoWhatsApp} />
    </a>
  </body>
</html>
