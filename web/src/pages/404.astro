---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <section class="encabezado" style="padding-bottom:96px">
    <div class="contenedor">
      <h1>Esta página no existe</h1>
      <p>Puede que el enlace haya cambiado al renovar nuestra web. Revisa el catálogo o vuelve al inicio.</p>
      <div class="hero__acciones">
        <a class="boton" href="/catalogo/">Ver catálogo</a>
        <a class="boton boton--borde" href="/">Ir al inicio</a>
      </div>
    </div>
  </section>
</Base>
