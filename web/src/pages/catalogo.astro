---
import Base from '../layouts/Base.astro';
import { esqueleto, enlaceWhatsApp } from '../lib/render.js';
---
<Base titulo="Catálogos" descripcion="Catálogos de regalos personalizados por ocasión. Pide el tuyo por WhatsApp con delivery en Lima.">
  <section class="encabezado">
    <div class="contenedor">
      <h1>Nuestros catálogos</h1>
      <p>Elige una ocasión y pide el regalo que te guste por WhatsApp. Los precios son referenciales y varían según la personalización.</p>
    </div>
  </section>

  <section class="seccion" style="padding-top:24px">
    <div class="contenedor">
      <div class="etiquetas etiquetas--fila" id="catalogo-filtros" role="group" aria-label="Elegir catálogo"></div>

      <div class="catalogo__barra">
        <h2 class="catalogo__titulo" id="catalogo-titulo"></h2>
        <span id="catalogo-conteo" aria-live="polite">Cargando catálogo…</span>
      </div>

      <div class="grilla" id="catalogo-grilla" aria-busy="true">
        <Fragment set:html={esqueleto(8)} />
      </div>

      <div class="catalogo__vacio" id="catalogo-vacio" hidden>
        <p><strong>Aún no tenemos regalos publicados aquí.</strong></p>
        <p><a href={enlaceWhatsApp('Hola Genia Creativa, quiero armar un regalo personalizado.')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> y armamos uno a tu medida.</p>
      </div>
      <noscript><p>Para ver el catálogo activa JavaScript o escríbenos por WhatsApp.</p></noscript>
    </div>
  </section>
</Base>

<script>
  import '../scripts/catalogo-filtro.js';
</script>
